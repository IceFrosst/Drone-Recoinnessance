    { "label": "D", "name": "+ cyclostationary + SEI", "cfg": { "rx": "bladerf", "frontEnd": "filterlna", "nulling": true, "excision": true, "cyclo": true, "sei": true } },
    { "label": "E", "name": "+ fused KrakenSDR", "cfg": { "rx": "fused", "frontEnd": "filterlna", "nulling": true, "excision": true, "cyclo": true, "sei": true } }
